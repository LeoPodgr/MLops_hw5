      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "format": "table",
          "rawSql": "SELECT model_version AS model_version,\n       COUNT(*) AS scores_written,\n       ROUND(100.0 * AVG(fraud_flag::numeric), 2) AS fraud_share_pct,\n       MAX(created_at) AS last_score_at\nFROM scores\nWHERE $__timeFilter(created_at)\nGROUP BY model_version\nORDER BY MAX(created_at) DESC",
          "refId": "A",
          "editorMode": "code"
        }
      ]
    }
